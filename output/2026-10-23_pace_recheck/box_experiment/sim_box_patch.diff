+/* scratch experiment — first-clear box: one item for a random party hero, fitted to that hero's class,
+   ilvl = cleared stage dlvl, rarity = drop weights with normal removed (magic floor). Separate rng stream. */
+const BOX_SLOTS = { weapon: ['weapon'], armor: ['armor'], helmet: ['helmet'], gloves: ['gloves'], boots: ['boots'],
+    mix5: ['weapon', 'armor', 'helmet', 'gloves', 'boots'], def4: ['armor', 'helmet', 'gloves', 'boots'] };
+function giveBox(SYS, B, G, seed, n, stageId, variant) {
+    const rng = makeRng(seed * 7919 + n * 104729 + 17);
+    const heroes = partyHeroes(SYS, G);
+    const h = heroes[Math.floor(rng() * heroes.length)];
+    const pool = BOX_SLOTS[variant];
+    const slot = pool[Math.floor(rng() * pool.length)];
+    const ilvl = Math.max(1, Number(D.stages[stageId].dlvl) || 1);
+    const weights = { normal: 0, magic: B.rarity_w_magic, rare: B.rarity_w_rare };
+    let it = null;
+    for (let k = 0; k < 40; k++) {
+        const gs = slot === 'weapon' ? SYS.item.groupsFor(h.cls) : null;
+        const opts = { slots: [slot], ilvl, rarityWeights: weights };
+        if (gs) opts.weaponGroup = gs[Math.floor(rng() * gs.length)].id;
+        it = SYS.item.rollGear(rng, opts)[0];
+        if (SYS.item.fitsClass(it, h.cls)) break;
+    }
+    G.counters.item += 1;
+    it.uid = `i${G.counters.item}`;
+    G.items[it.uid] = it;
+    G.bags[0].push(it.uid);
+    return slot;
+}
