        "nodes": {
          "arc_trueaim": [
            {
              "slot": 2,
              "hold": false,
              "desc": {
                "ko": "느려짐 감소",
                "en": "Less slowdown"
              }
            },
            {
              "slot": 3,
              "hold": false,
              "desc": {
                "ko": "창 동안 평타를 아예 쏘지 않는 대신 스킬 쿨타임 가속",
                "en": "No basic attacks during the window but skill cooldowns run faster"
              }
            },
            {
              "slot": 4,
              "hold": false,
              "desc": {
                "ko": "창 동안 단일 스킬이 후열을 먼저 노림",
                "en": "During the window single-target skills aim at the back row first"
              }
            }
          ],
          "arc_singlestrike": [
            {
              "slot": 2,
              "hold": false,
              "desc": {
                "ko": "남은 적이 적을수록 피해 증가 — 혼자 남은 적에게 가장 강함",
                "en": "More damage the fewer enemies remain — strongest against a lone enemy"
              }
            },
            {
              "slot": 3,
              "hold": false,
              "desc": {
                "ko": "조준 — 행동 n회를 쏘지 않고 겨눈 뒤 발사 · 대신 피해 대폭 증가",
                "en": "Aim — skips n actions to aim then fires · deals much more damage"
              }
            },
            {
              "slot": 4,
              "hold": false,
              "desc": {
                "ko": "일격이 한 발 더 따라갑니다(같은 대상 · 먼저 쓰러지면 다음 대상)",
                "en": "A second shot follows (same target · the next one if it falls)"
              }
            }
          ],
          "arc_reload": [
            {
              "slot": 2,
              "hold": false,
              "desc": {
                "ko": "초기화된 스킬의 다음 한 방 강화",
                "en": "The next shot of the reset skill hits harder"
              }
            },
            {
              "slot": 3,
              "hold": false,
              "desc": {
                "ko": "쓰러뜨린 스킬만이 아니라 모든 액티브의 쿨타임 초기화",
                "en": "Resets the cooldowns of all actives and not only the skill that got the kill"
              }
            },
            {
              "slot": 4,
              "hold": false,
              "desc": {
                "ko": "창 동안 스킬로 쓰러뜨리면 적 전원 짧게 경직",
                "en": "During the window skill kills briefly Stagger all enemies"
              }
            }
          ],
          "arc_quickdraw": [
            {
              "slot": 2,
