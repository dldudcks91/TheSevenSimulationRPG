"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json, shutil
from pathlib import Path
from PIL import Image
p=Path('output/2026-11-04_defeat_blood/v3/prompts_part1.json')
data=json.loads(p.read_text(encoding='utf-8'))
for row in data['images']:
    dst=Path(row['file'])
    shutil.copy2(row['source_path'], dst)
    with Image.open(dst) as im:
        alpha=im.getchannel('A')
        fraction=alpha.histogram()[0]/(im.width*im.height)
        below=alpha.crop((0,185,im.width,im.height))
        count=sum(below.histogram()[1:])
        row['validation']={'PIL_mode':im.mode,'size':list(im.size),'fully_transparent_fraction':fraction,'nontransparent_pixels_below_18_percent':count,'alpha_bbox':alpha.getbbox()}
        print(dst.name, im.mode, im.size, f'fully_transparent_fraction={fraction:.10f}', f'nontransparent_pixels_below_18_percent={count}', f'alpha_bbox={alpha.getbbox()}')
p.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\\n',encoding='utf-8')
